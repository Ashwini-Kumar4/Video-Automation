# Clerk Authentication Keys
# Get your keys at https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk Custom Routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Neon PostgreSQL Database Connection (Drizzle ORM)
# Get your connection string from https://console.neon.tech
DATABASE_URL=postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require

# AWS S3 Storage Configuration
# Used for storing user video uploads and generating signed viewing URLs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_BUCKET_NAME=your-s3-bucket-name

# Inngest Background Workflow Engine
# Run locally with: npx inngest-cli@latest dev
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Deepgram AI Speech-to-Text API Key
# Get your free API key at https://console.deepgram.com
DEEPGRAM_API_KEY=your-deepgram-api-key

# Google Gemini AI API Key
# Get your key at https://aistudio.google.com -> Get API Key
# Used to analyze video transcripts and generate viral engaging shorts (20-90s)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Arcjet Security & AI Protection
# Get your free API key at https://app.arcjet.com
# Provides AI Endpoint Abuse Protection, Prompt Injection Detection, Bot Shield & 2 videos/day rate limiting
ARCJET_KEY=ajkey_your_arcjet_key_here
ARCJET_ENV=development

# Remotion Lambda Video Rendering Configuration
REMOTION_AWS_ACCESS_KEY_ID=your-remotion-aws-access-key-id
REMOTION_AWS_SECRET_ACCESS_KEY=your-remotion-aws-secret-access-key
REMOTION_AWS_REGION=ap-southeast-2
REMOTION_FUNCTION_NAME=remotion-render-4-0-536-mem2048mb-disk2048mb-120sec
REMOTION_BUCKET_NAME=your-remotion-bucket-name
REMOTION_SITE_NAME=vidshorts-site
REMOTION_SERVE_URL=

